<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>🌍 GeoWorld - Explore Countries</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
}

body{
  font-family:Arial, sans-serif;
  background:linear-gradient(135deg,#061b33,#063b5c,#087f8c);
  color:white;
  min-height:100vh;
}

header{
  background:rgba(0,20,40,.85);
  padding:22px 15px;
  text-align:center;
  box-shadow:0 4px 20px rgba(0,0,0,.3);
}

.logo{
  font-size:32px;
  font-weight:bold;
}

.subtitle{
  margin-top:8px;
  color:#bdefff;
}

.search-box{
  max-width:650px;
  margin:25px auto;
  padding:0 15px;
}

.search-box input{
  width:100%;
  padding:16px 20px;
  border-radius:30px;
  border:2px solid #50d9ff;
  outline:none;
  font-size:16px;
  background:white;
  color:#111;
}

.globe-section{
  text-align:center;
  padding:25px 15px;
}

.globe{
  width:300px;
  height:300px;
  margin:20px auto;
  border-radius:50%;
  position:relative;
  overflow:hidden;

  background:
    radial-gradient(circle at 35% 30%,
    #65eaff 0%,
    #159bd3 35%,
    #07518d 70%,
    #022b50 100%);

  box-shadow:
    inset -35px -20px 50px rgba(0,0,0,.6),
    inset 20px 15px 30px rgba(255,255,255,.25),
    0 0 45px rgba(80,220,255,.6);

  animation:spin 18s linear infinite;
}

.globe::before{
  content:"";
  position:absolute;
  width:130%;
  height:130%;
  left:-15%;
  top:-15%;

  background:
    repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 35px,
      rgba(255,255,255,.13) 36px,
      transparent 37px
    ),
    repeating-linear-gradient(
      90deg,
      transparent 0px,
      transparent 35px,
      rgba(255,255,255,.13) 36px,
      transparent 37px
    );

  border-radius:50%;
}

.globe::after{
  content:"🌎";
  position:absolute;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:135px;
  filter:drop-shadow(10px 12px 8px rgba(0,0,0,.35));
  opacity:.92;
}

@keyframes spin{
  from{transform:rotateY(0deg);}
  to{transform:rotateY(360deg);}
}

.globe-title{
  font-size:27px;
  margin-top:15px;
}

.globe-text{
  color:#c8f6ff;
  margin-top:8px;
}

.container{
  max-width:1200px;
  margin:auto;
  padding:20px;
}

.stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px;
  margin:20px 0;
}

.stat{
  background:rgba(255,255,255,.12);
  border:1px solid rgba(255,255,255,.2);
  padding:20px;
  border-radius:15px;
  text-align:center;
  backdrop-filter:blur(8px);
}

.stat-number{
  font-size:28px;
  font-weight:bold;
}

.stat-label{
  margin-top:5px;
  color:#bdefff;
}

.countries{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:18px;
}

.card{
  background:white;
  color:#123;
  border-radius:18px;
  padding:20px;
  box-shadow:0 8px 25px rgba(0,0,0,.25);
  transition:.25s;
}

.card:hover{
  transform:translateY(-6px);
}

.flag{
  font-size:48px;
  margin-bottom:10px;
}

.card h2{
  margin-bottom:12px;
  color:#063b5c;
}

.card p{
  margin:7px 0;
  font-size:14px;
}

.card strong{
  color:#07518d;
}

button{
  margin-top:12px;
  padding:10px 16px;
  border:0;
  border-radius:20px;
  background:#087f8c;
  color:white;
  cursor:pointer;
}

button:hover{
  background:#055765;
}

.loading{
  text-align:center;
  padding:40px;
  font-size:20px;
}

footer{
  margin-top:40px;
  padding:25px;
  text-align:center;
  background:rgba(0,20,40,.8);
  color:#bdefff;
}

@media(max-width:600px){
  .logo{
    font-size:26px;
  }

  .globe{
    width:240px;
    height:240px;
  }

  .globe::after{
    font-size:105px;
  }

  .stats{
    grid-template-columns:1fr;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">🌍 GeoWorld</div>
  <div class="subtitle">
    Explore Countries of the World
  </div>
</header>

<div class="search-box">
  <input
    type="text"
    id="search"
    placeholder="🔎 Search a country..."
  >
</div>

<section class="globe-section">

  <div class="globe"></div>

  <div class="globe-title">
    World Explorer
  </div>

  <div class="globe-text">
    Explore countries and their basic geographical information.
  </div>

</section>

<div class="container">

  <div class="stats">

    <div class="stat">
      <div class="stat-number" id="countryCount">0</div>
      <div class="stat-label">Countries Loaded</div>
    </div>

    <div class="stat">
      <div class="stat-number">7</div>
      <div class="stat-label">Continents</div>
    </div>

    <div class="stat">
      <div class="stat-number">🌎</div>
      <div class="stat-label">One World</div>
    </div>

  </div>

  <div id="countries" class="countries">
    <div class="loading">
      🌍 Loading countries...
    </div>
  </div>

</div>

<footer>
  🌍 GeoWorld © 2026  
  <br>
  Explore • Learn • Discover
</footer>

<script>

let allCountries = [];

/* Load countries */

async function loadCountries(){

  const container = document.getElementById("countries");

  try{

    const response = await fetch(
      "https://restcountries.com/v3.1/all?fields=name,flags,capital,region,subregion,population,currencies,languages"
    );

    if(!response.ok){
      throw new Error("Unable to load countries");
    }

    allCountries = await response.json();

    allCountries.sort((a,b)=>
      a.name.common.localeCompare(b.name.common)
    );

    document.getElementById("countryCount").textContent =
      allCountries.length;

    displayCountries(allCountries);

  }catch(error){

    container.innerHTML = `
      <div class="loading">
        ❌ Countries could not be loaded.
        <br><br>
        Please check your internet connection.
      </div>
    `;

  }

}


/* Display countries */

function displayCountries(countries){

  const container = document.getElementById("countries");

  if(countries.length === 0){

    container.innerHTML = `
      <div class="loading">
        🔎 No country found.
      </div>
    `;

    return;
  }

  container.innerHTML = countries
    .map(country => createCard(country))
    .join("");

}


/* Create country card */

function createCard(country){

  const name = country.name?.common || "Unknown";

  const flag = country.flags?.emoji || "🌍";

  const capital =
    country.capital?.[0] || "N/A";

  const region =
    country.region || "N/A";

  const subregion =
    country.subregion || "N/A";

  const population =
    country.population
      ? country.population.toLocaleString()
      : "N/A";

  let currency = "N/A";

  if(country.currencies){

    currency =
      Object.entries(country.currencies)
      .map(([code,data]) =>
        `${data.name} (${code})`
      )
      .join(", ");

  }

  let languages = "N/A";

  if(country.languages){

    languages =
      Object.values(country.languages)
      .join(", ");

  }

  return `

    <div class="card">

      <div class="flag">
        ${flag}
      </div>

      <h2>${name}</h2>

      <p>
        <strong>🏛️ Capital:</strong>
        ${capital}
      </p>

      <p>
        <strong>🌎 Region:</strong>
        ${region}
      </p>

      <p>
        <strong>📍 Subregion:</strong>
        ${subregion}
      </p>

      <p>
        <strong>👥 Population:</strong>
        ${population}
      </p>

      <p>
        <strong>💰 Currency:</strong>
        ${currency}
      </p>

      <p>
        <strong>🗣️ Languages:</strong>
        ${languages}
      </p>

    </div>

  `;

}


/* Search */

document
  .getElementById("search")
  .addEventListener("input", function(){

    const searchText =
      this.value.toLowerCase().trim();

    const filtered =
      allCountries.filter(country => {

        const name =
          country.name?.common
          ?.toLowerCase() || "";

        return name.includes(searchText);

      });

    displayCountries(filtered);

  });


/* Start */

loadCountries();

</script>

</body>
</html>
