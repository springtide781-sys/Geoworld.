<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>GeoWorld - Explore the World</title>

<style>
* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #eef6ff;
  color: #172033;
}

header {
  background: linear-gradient(135deg, #0645ad, #0088cc);
  color: white;
  text-align: center;
  padding: 25px 15px;
}

header h1 {
  margin: 0;
  font-size: 32px;
}

header p {
  margin: 8px 0 0;
  font-size: 16px;
}

.search-box {
  max-width: 600px;
  margin: 20px auto;
  padding: 0 15px;
}

.search-box input {
  width: 100%;
  padding: 15px 20px;
  border-radius: 30px;
  border: 2px solid #168de2;
  font-size: 16px;
  outline: none;
}

.globe-container {
  width: 100%;
  max-width: 850px;
  height: 550px;
  margin: auto;
  position: relative;
  overflow: hidden;
  background: #06152e;
  border-radius: 20px;
  box-shadow: 0 10px 35px rgba(0,0,0,0.25);
}

#globe {
  width: 100%;
  height: 100%;
}

.instructions {
  text-align: center;
  color: white;
  position: absolute;
  bottom: 12px;
  left: 0;
  right: 0;
  pointer-events: none;
  font-size: 14px;
  opacity: 0.8;
}

.section-title {
  text-align: center;
  margin: 35px 10px 20px;
}

.country-grid {
  max-width: 1000px;
  margin: auto;
  padding: 0 15px 40px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 18px;
}

.country-card {
  background: white;
  border-radius: 15px;
  padding: 20px;
  box-shadow: 0 5px 20px rgba(0,0,0,0.10);
  transition: 0.25s;
}

.country-card:hover {
  transform: translateY(-5px);
}

.country-card h2 {
  margin-top: 0;
  color: #0757b8;
}

.country-card p {
  margin: 8px 0;
}

footer {
  background: #063b91;
  color: white;
  text-align: center;
  padding: 18px;
}
</style>

<!-- Globe library -->
<script src="https://unpkg.com/globe.gl"></script>

</head>

<body>

<header>
  <h1>🌍 GeoWorld</h1>
  <p>Explore Countries of the World</p>
</header>

<div class="search-box">
  <input
    type="text"
    id="search"
    placeholder="🔍 Search a country..."
    onkeyup="searchCountry()"
  >
</div>

<div class="globe-container">
  <div id="globe"></div>
  <div class="instructions">
    👆 Drag to rotate • 🔎 Scroll/Pinch to zoom
  </div>
</div>

<h2 class="section-title">🌎 World Explorer</h2>

<div class="country-grid" id="countries">

  <div class="country-card" data-country="India">
    <h2>🇮🇳 India</h2>
    <p><b>Capital:</b> New Delhi</p>
    <p><b>Continent:</b> Asia</p>
    <p><b>Currency:</b> Indian Rupee</p>
  </div>

  <div class="country-card" data-country="Japan">
    <h2>🇯🇵 Japan</h2>
    <p><b>Capital:</b> Tokyo</p>
    <p><b>Continent:</b> Asia</p>
    <p><b>Currency:</b> Yen</p>
  </div>

  <div class="country-card" data-country="France">
    <h2>🇫🇷 France</h2>
    <p><b>Capital:</b> Paris</p>
    <p><b>Continent:</b> Europe</p>
    <p><b>Currency:</b> Euro</p>
  </div>

  <div class="country-card" data-country="Brazil">
    <h2>🇧🇷 Brazil</h2>
    <p><b>Capital:</b> Brasília</p>
    <p><b>Continent:</b> South America</p>
    <p><b>Currency:</b> Brazilian Real</p>
  </div>

  <div class="country-card" data-country="United States">
    <h2>🇺🇸 United States</h2>
    <p><b>Capital:</b> Washington, D.C.</p>
    <p><b>Continent:</b> North America</p>
    <p><b>Currency:</b> US Dollar</p>
  </div>

  <div class="country-card" data-country="Australia">
    <h2>🇦🇺 Australia</h2>
    <p><b>Capital:</b> Canberra</p>
    <p><b>Continent:</b> Oceania</p>
    <p><b>Currency:</b> Australian Dollar</p>
  </div>

  <div class="country-card" data-country="China">
    <h2>🇨🇳 China</h2>
    <p><b>Capital:</b> Beijing</p>
    <p><b>Continent:</b> Asia</p>
    <p><b>Currency:</b> Yuan</p>
  </div>

  <div class="country-card" data-country="Canada">
    <h2>🇨🇦 Canada</h2>
    <p><b>Capital:</b> Ottawa</p>
    <p><b>Continent:</b> North America</p>
    <p><b>Currency:</b> Canadian Dollar</p>
  </div>

  <div class="country-card" data-country="Germany">
    <h2>🇩🇪 Germany</h2>
    <p><b>Capital:</b> Berlin</p>
    <p><b>Continent:</b> Europe</p>
    <p><b>Currency:</b> Euro</p>
  </div>

  <div class="country-card" data-country="United Kingdom">
    <h2>🇬🇧 United Kingdom</h2>
    <p><b>Capital:</b> London</p>
    <p><b>Continent:</b> Europe</p>
    <p><b>Currency:</b> Pound Sterling</p>
  </div>

  <div class="country-card" data-country="Russia">
    <h2>🇷🇺 Russia</h2>
    <p><b>Capital:</b> Moscow</p>
    <p><b>Continent:</b> Europe & Asia</p>
    <p><b>Currency:</b> Russian Ruble</p>
  </div>

  <div class="country-card" data-country="South Africa">
    <h2>🇿🇦 South Africa</h2>
    <p><b>Capital:</b> Pretoria</p>
    <p><b>Continent:</b> Africa</p>
    <p><b>Currency:</b> Rand</p>
  </div>

</div>

<footer>
  🌍 GeoWorld | Learn Geography Around the World
</footer>

<script>

const globeElement = document.getElementById("globe");

const world = Globe()
  (globeElement)
  .globeImageUrl(
    "https://unpkg.com/three-globe/example/img/earth-blue-marble.jpg"
  )
  .backgroundImageUrl(
    "https://unpkg.com/three-globe/example/img/night-sky.png"
  )
  .bumpImageUrl(
    "https://unpkg.com/three-globe/example/img/earth-topology.png"
  )
  .showAtmosphere(true)
  .atmosphereColor("#4fc3ff")
  .atmosphereAltitude(0.18);

world.controls().autoRotate = true;
world.controls().autoRotateSpeed = 0.35;

function searchCountry() {

  const input =
    document.getElementById("search")
      .value
      .toLowerCase()
      .trim();

  const cards =
    document.querySelectorAll(".country-card");

  cards.forEach(card => {

    const country =
      card.dataset.country.toLowerCase();

    if (country.includes(input)) {
      card.style.display = "block";
    } else {
      card.style.display = "none";
    }

  });
}

window.addEventListener("resize", () => {
  world.width(window.innerWidth);
});

</script>

</body>
</html>
